{
  "$schema": "https://trykatch.net/schemas/module-manifest.v1.json",
  "schemaVersion": 1,
  "id": "projects",
  "name": "Projects",
  "version": "1.0.0",
  "description": "Organization-scoped project management and lifecycle reference feature.",
  "publisher": "trykatch",
  "distribution": {
    "kind": "workspace",
    "license": "Apache-2.0"
  },
  "compatibility": {
    "minimumHostVersion": "0.1.0",
    "maximumHostVersionExclusive": "1.0.0"
  },
  "requires": [],
  "optionalDependencies": [],
  "capabilities": ["api", "web", "data", "background-work", "assistant"],
  "dataOwnership": {
    "default": "organization",
    "resources": [
      {
        "name": "projects",
        "schema": "app",
        "table": "projects",
        "ownership": "organization",
        "entityType": "TrykatchApp.Domain.Projects.Project",
        "isolationPolicy": "projects_organization_isolation"
      }
    ]
  },
  "artifacts": {
    "dotnetProject": "src/TrykatchApp.Infrastructure/TrykatchApp.Infrastructure.csproj",
    "webPackage": "web/apps/web/package.json"
  },
  "entrypoints": {
    "dotnet": {
      "type": "TrykatchApp.Infrastructure.Modules.ProjectsModule"
    },
    "web": {
      "specifier": "./features/projects/module",
      "export": "projectsModule"
    }
  },
  "contributions": {
    "permissions": ["projects.read", "projects.manage"],
    "routes": [
      { "id": "projects.list", "path": "/projects" }
    ],
    "extensionPoints": [
      { "id": "projects.list.after-table" }
    ],
    "extensions": [],
    "assistantTools": [
      {
        "name": "trykatch_list_projects",
        "operationId": "Projects_List",
        "risk": "read-only",
        "requiresHumanConfirmation": false
      },
      {
        "name": "trykatch_get_project",
        "operationId": "Projects_Get",
        "risk": "read-only",
        "requiresHumanConfirmation": false
      }
    ]
  }
}
