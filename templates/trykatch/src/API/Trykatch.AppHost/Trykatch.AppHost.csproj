<Project Sdk="Aspire.AppHost.Sdk/13.5.3">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <DefineConstants Condition="'$(SelectedUi)' == 'react'">$(DefineConstants);HAS_REACT_UI</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Trykatch.Api/Trykatch.Api.csproj" AspireProjectMetadataTypeName="TemplateProjectIdentifier_Api" />
    <ProjectReference Include="../Trykatch.Migrator/Trykatch.Migrator.csproj" AspireProjectMetadataTypeName="TemplateProjectIdentifier_Migrator" />
  </ItemGroup>
</Project>
