{
  "AllowedHosts": "*",
  "AtomicMutationResponse": {
    "MaximumBytes": 1048576
  },
  "AuditProjection": {
    "BatchSize": 50,
    "PollInterval": "00:00:05",
    "BacklogWarningCount": 1000,
    "BacklogWarningAge": "00:02:00"
  },
  "OutboxRecovery": {
    "BatchSize": 50,
    "MaximumAttempts": 10,
    "PollInterval": "00:00:05",
    "RetryBaseDelay": "00:00:01",
    "RetryMaximumDelay": "00:00:30",
    "TransportTimeout": "00:00:30",
    "DatabaseCommandTimeout": "00:00:30",
    "DatabaseLockTimeout": "00:00:05",
    "BatchWorkBudget": "00:01:00"
  }
}
