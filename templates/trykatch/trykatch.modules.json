{
  "$schema": "https://trykatch.net/schemas/module-catalog.v1.json",
  "schemaVersion": 1,
  "hostVersion": "0.1.0",
  "lockFile": "trykatch.modules.lock.json",
  "trustedPublishers": [
    "trykatch"
  ],
  "outputs": {
    "backend": "src/TrykatchApp.Api/Modules/EnabledModules.cs",
    "backendNamespace": "TrykatchApp.Api.Modules",
    "dotnetModuleContractNamespace": "TrykatchApp.Modules",
    "migrator": "src/TrykatchApp.Migrator/Modules/EnabledModules.cs",
    "migratorNamespace": "TrykatchApp.Migrator.Modules",
    "web": "web/apps/web/src/modules.ts",
    "webModuleSdkSpecifier": "@trykatchapp/module-sdk"
  },
  "modules": [
    {
      "id": "projects",
      "manifest": "src/TrykatchApp.Infrastructure/Modules/projects.trykatch.module.json",
      "enabled": true
    },
    {
      "id": "federation",
      "manifest": "src/TrykatchApp.Modules.Federation/trykatch.module.json",
      "enabled": false
    },
    {
      "id": "documents",
      "manifest": "modules/documents/trykatch.module.json",
      "enabled": true
    }
  ]
}
