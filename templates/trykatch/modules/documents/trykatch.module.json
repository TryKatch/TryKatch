{
  "$schema": "https://trykatch.net/schemas/module-manifest.v1.json",
  "schemaVersion": 1,
  "id": "documents",
  "name": "Documents",
  "version": "1.0.0",
  "description": "Independent organization-owned CRUD and full-stack module proof.",
  "publisher": "trykatch",
  "distribution": { "kind": "workspace", "license": "Apache-2.0" },
  "compatibility": { "minimumHostVersion": "0.1.0", "maximumHostVersionExclusive": "1.0.0" },
  "requires": ["projects"],
  "optionalDependencies": [],
  "capabilities": ["api", "web", "data", "background-work", "assistant"],
  "dataOwnership": {
    "default": "organization",
    "resources": [{
      "name": "documents",
      "schema": "app",
      "table": "documents",
      "ownership": "organization",
      "entityType": "Trykatch.Modules.Documents.DocumentRecord",
      "isolationPolicy": "documents_organization_isolation"
    }]
  },
  "artifacts": {
    "dotnetProject": "modules/documents/dotnet/Trykatch.Modules.Documents.csproj",
    "webPackage": "modules/documents/web/package.json"
  },
  "entrypoints": {
    "dotnet": { "type": "Trykatch.Modules.Documents.DocumentsModule" },
    "web": { "specifier": "@trykatch-modules/documents", "export": "documentsModule" }
  },
  "contributions": {
    "permissions": ["documents.read", "documents.manage"],
    "routes": [{ "id": "documents.list", "path": "/documents" }],
    "extensionPoints": [{ "id": "documents.list.after-table" }],
    "extensions": [{ "id": "documents.projects-presence", "point": "projects.list.after-table" }],
    "assistantTools": [
      { "name": "trykatch_list_documents", "operationId": "Documents_List", "risk": "read-only", "requiresHumanConfirmation": false },
      { "name": "trykatch_create_document", "operationId": "Documents_Create", "risk": "state-changing", "requiresHumanConfirmation": true },
      { "name": "trykatch_update_document", "operationId": "Documents_Update", "risk": "state-changing", "requiresHumanConfirmation": true }
    ]
  }
}
