{
  "$schema": "https://json.schemastore.org/template",
  "author": "Trykatch contributors",
  "classifications": ["Web", "API", "SaaS", "PostgreSQL", "React", "Aspire"],
  "identity": "Trykatch.Templates.Enterprise",
  "groupIdentity": "Trykatch.Templates",
  "name": "Trykatch enterprise multi-tenant application",
  "description": "A production-oriented .NET 10 and React solution with PostgreSQL tenant isolation, organization RBAC, secure identity, and open-source observability.",
  "shortName": "trykatch",
  "defaultName": "Trykatch",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "display-name": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "Customer-facing product name. Defaults to the project name when omitted."
    },
    "displayNameSource": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "display-name",
        "fallbackVariableName": "name"
      }
    },
    "displayNameLiteral": {
      "type": "derived",
      "valueSource": "displayNameSource",
      "valueTransform": "displayNameJson",
      "replaces": "\"Trykatch Product\""
    },
    "legacyApplicationRoot": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "namespaceName",
      "replaces": "TrykatchApp",
      "description": "Preserves preview.9 application contract names after project generation."
    },
    "safeName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "namespaceName",
      "replaces": "Trykatch",
      "fileRename": "Trykatch",
      "description": "A C#-safe namespace and project path derived from the requested name."
    },
    "slugSource": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "kebabName"
    },
    "deploymentName": {
      "type": "derived",
      "valueSource": "slugSource",
      "valueTransform": "lowerCase",
      "replaces": "trykatch-app-slug",
      "description": "A lowercase deployment-safe name."
    },
    "projectIdentifier": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identifierName",
      "replaces": "TemplateProjectIdentifier",
      "description": "A C# identifier-safe name for generated Aspire project-reference types."
    },
    "ui": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Frontend to include.",
      "defaultValue": "react",
      "choices": [
        { "choice": "react", "description": "React, Vite, TanStack, and the Trykatch component system." },
        { "choice": "none", "description": "Backend-only output." }
      ]
    },
    "HAS_REACT_UI": {
      "type": "computed",
      "value": "(ui == \"react\")"
    },
    "email": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include SMTP email and Mailpit development support.",
      "defaultValue": "false"
    },
    "TRYKATCH_EMAIL": {
      "type": "computed",
      "value": "(email)"
    },
    "storage": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include local and S3-compatible object storage adapters.",
      "defaultValue": "true"
    },
    "TRYKATCH_STORAGE": {
      "type": "computed",
      "value": "(storage)"
    },
    "documents": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include spreadsheet and PDF exporters.",
      "defaultValue": "false"
    },
    "images": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Include image validation and processing.",
      "defaultValue": "false"
    }
  },
  "forms": {
    "displayNameJson": {
      "identifier": "jsonEncode"
    },
    "namespaceName": {
      "identifier": "replace",
      "pattern": "[-\\s]+",
      "replacement": "."
    },
    "kebabName": {
      "identifier": "replace",
      "pattern": "[\\s._]+",
      "replacement": "-"
    },
    "identifierName": {
      "identifier": "replace",
      "pattern": "[.\\-\\s]+",
      "replacement": "_"
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**/*",
        "**/bin/**",
        "**/obj/**",
        "**/node_modules/**",
        "**/dist/**",
        "**/storybook-static/**",
        "**/.env",
        "**/.env.*",
        "**/secrets/**",
        "**/*.pfx",
        "**/*.p12",
        "**/*.pem",
        "**/*.key",
        ".git/**",
        ".idea/**",
        ".vscode/**",
        ".vercel/**",
        "web/apps/web/public/marketing/**",
        "web/apps/web/src/router.tsx",
        "web/apps/web/src/views/LandingPage.tsx",
        "web/apps/web/src/views/LandingPage.test.tsx",
        "web/apps/web/src/views/landing.stories.tsx",
        "web/apps/web/src/components/LandingPreferencesMenu.tsx",
        "web/apps/web/src/components/LaunchVideo.tsx",
        "web/apps/web/e2e/landing.spec.ts",
        "**/.playwright-cli/**",
        "artifacts/**",
        "output/**",
        "**/coverage/**",
        "**/playwright-report/**",
        "**/test-results/**",
        "**/*.tsbuildinfo",
        "**/packages.lock.json",
        "**/*.user",
        "**/*.trx",
        "**/*.log",
        "**/*.nupkg",
        "**/*.snupkg",
        "**/.DS_Store"
      ],
      "modifiers": [
        {
          "condition": "(ui == \"none\")",
          "exclude": [
            "web/**",
            "scripts/test-proxy-headers.sh",
            ".github/workflows/web.yml",
            ".vercelignore",
            "vercel.json",
            "package.json",
            "compose.yml",
            "README.md"
          ],
          "rename": {
            "compose.backend.yml": "compose.yml",
            "README.backend.md": "README.md"
          }
        },
        {
          "condition": "(ui == \"react\")",
          "exclude": [
            "compose.backend.yml",
            "README.backend.md"
          ]
        },
        {
          "condition": "(!email)",
          "exclude": ["src/Common/Trykatch.Infrastructure/Optional/Email/**"]
        },
        {
          "condition": "(!documents)",
          "exclude": ["src/Common/Trykatch.Infrastructure/Optional/Documents/**"]
        },
        {
          "condition": "(!images)",
          "exclude": ["src/Common/Trykatch.Infrastructure/Optional/Images/**"]
        }
      ]
    },
    {
      "condition": "(ui == \"react\")",
      "source": ".template.config/generated/",
      "target": "./"
    },
    {
      "source": "./",
      "target": "./",
      "include": [".env.example"],
      "exclude": [".template.config/**/*"]
    }
  ],
  "primaryOutputs": [
    { "path": "Trykatch.slnx" }
  ],
  "postActions": [
    {
      "condition": "(ui == \"react\")",
      "description": "Start here: developer onboarding (backend and React).",
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "continueOnError": true,
      "manualInstructions": [
        { "text": "Open docs/developer-onboarding.md (French: docs/developer-onboarding.fr.md).\nFor a concrete startup-to-Equipment walkthrough: docs/first-feature.md (French: docs/first-feature.fr.md).\nUsing your existing coding assistant? Ask: Read AGENTS.md and docs/developer-onboarding.md, inspect this checkout, and explain architecture, module creation, backend/frontend wiring, integrations and verification. Start read-only.\nNo additional AI provider key is required for onboarding. Follow README.md to start the application; this message does not run setup or an AI tool." }
      ]
    },
    {
      "condition": "(ui == \"none\")",
      "description": "Start here: developer onboarding (backend-only).",
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "continueOnError": true,
      "manualInstructions": [
        { "text": "Open docs/developer-onboarding.md (French: docs/developer-onboarding.fr.md).\nFor a concrete startup-to-Equipment walkthrough: docs/first-feature.md (French: docs/first-feature.fr.md); skip frontend steps.\nUsing your existing coding assistant? Ask: Read AGENTS.md and docs/developer-onboarding.md, inspect this checkout, and explain architecture, module creation, integrations and verification. Start read-only; skip frontend steps in this backend-only application.\nNo additional AI provider key is required for onboarding. Follow README.md to start the application; this message does not run setup or an AI tool." }
      ]
    },
    {
      "condition": "(OS != \"Windows_NT\")",
      "description": "Initialize Git source control for the generated application.",
      "manualInstructions": [
        { "text": "Run 'bash scripts/initialize-git.sh' from the generated application directory." }
      ],
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "continueOnError": true,
      "args": {
        "executable": "bash",
        "args": "scripts/initialize-git.sh",
        "redirectStandardOutput": false,
        "redirectStandardError": false
      }
    },
    {
      "condition": "(OS == \"Windows_NT\")",
      "description": "Initialize Git source control for the generated application.",
      "manualInstructions": [
        { "text": "Run 'scripts\\initialize-git.cmd' from the generated application directory." }
      ],
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "continueOnError": true,
      "args": {
        "executable": "cmd",
        "args": "/c scripts\\initialize-git.cmd",
        "redirectStandardOutput": false,
        "redirectStandardError": false
      }
    }
  ]
}
