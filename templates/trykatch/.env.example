TRYKATCH_POSTGRES_ADMIN_PASSWORD=replace-with-a-bootstrap-only-random-secret
TRYKATCH_MIGRATOR_PASSWORD=replace-with-migrator-random-secret
TRYKATCH_RUNTIME_PASSWORD=replace-with-runtime-random-secret
TRYKATCH_MIGRATOR_CONNECTION=Host=postgres;Port=5432;Database=trykatch;Username=trykatch_migrator;Password=replace-with-migrator-random-secret
TRYKATCH_RUNTIME_CONNECTION=Host=postgres;Port=5432;Database=trykatch;Username=trykatch_runtime;Password=replace-with-runtime-random-secret
TRYKATCH_PUBLIC_URL=https://app.example.com
# The web container is expected to sit behind an HTTPS ingress on the same host.
TRYKATCH_WEB_BIND_ADDRESS=127.0.0.1
# Keep the gateway and reserved proxy IPs outside the automatic allocation range.
# Change all five values together when the subnet overlaps another Docker network.
TRYKATCH_NETWORK_SUBNET=172.30.250.0/24
TRYKATCH_NETWORK_DYNAMIC_RANGE=172.30.250.128/25
TRYKATCH_NETWORK_GATEWAY=172.30.250.1
TRYKATCH_INGRESS_PROXY_IP=172.30.250.2
TRYKATCH_WEB_PROXY_IP=172.30.250.10
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-secret
GRAFANA_BIND_ADDRESS=127.0.0.1
TRYKATCH_SECRETS_PATH=./secrets
TRYKATCH_SIGNING_CERTIFICATE_PASSWORD=replace-with-the-signing-certificate-secret
TRYKATCH_ENCRYPTION_CERTIFICATE_PASSWORD=replace-with-the-encryption-certificate-secret
# Set these only for the first controlled bootstrap, then remove them.
TRYKATCH_BOOTSTRAP_ADMIN_EMAIL=
TRYKATCH_BOOTSTRAP_ADMIN_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=trykatch-app-slug-api
OTEL_SERVICE_NAMESPACE=trykatch
OTEL_DEPLOYMENT_ENVIRONMENT=production
OTEL_TRACES_SAMPLER_ARG=0.10
TRYKATCH_ENVIRONMENT=Production
# Required immutable image/build identifier, for example a release tag or commit SHA.
TRYKATCH_RELEASE_VERSION=replace-with-release-id
# Used only with compose.observability-tls.yml. The headers file contains
# Authorization=Bearer%20<token>; keep it and the certificate material out of Git.
TRYKATCH_TELEMETRY_SECRETS_PATH=./secrets/telemetry
# Optional client bootstrap: OpenIddict__Clients__0__ClientId, __GrantType,
# __ClientSecret, and __RedirectUris__0. Remove secrets after provisioning.
