TRYKATCH_POSTGRES_ADMIN_PASSWORD=replace-with-a-bootstrap-only-random-secret
TRYKATCH_MIGRATOR_PASSWORD=replace-with-migrator-random-secret
TRYKATCH_RUNTIME_PASSWORD=replace-with-runtime-random-secret
TRYKATCH_MIGRATOR_CONNECTION=Host=postgres;Port=5432;Database=trykatch;Username=trykatch_migrator;Password=replace-with-migrator-random-secret
TRYKATCH_RUNTIME_CONNECTION=Host=postgres;Port=5432;Database=trykatch;Username=trykatch_runtime;Password=replace-with-runtime-random-secret
TRYKATCH_PUBLIC_URL=https://app.example.com
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-secret
TRYKATCH_SECRETS_PATH=./secrets
TRYKATCH_SIGNING_CERTIFICATE_PASSWORD=replace-with-the-signing-certificate-secret
TRYKATCH_ENCRYPTION_CERTIFICATE_PASSWORD=replace-with-the-encryption-certificate-secret
# Set these only for the first controlled bootstrap, then remove them.
TRYKATCH_BOOTSTRAP_ADMIN_EMAIL=
TRYKATCH_BOOTSTRAP_ADMIN_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Optional client bootstrap: OpenIddict__Clients__0__ClientId, __GrantType,
# __ClientSecret, and __RedirectUris__0. Remove secrets after provisioning.
