<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>trykatch</ToolCommandName>
    <PackageId>Trykatch.Cli</PackageId>
    <PackageVersion>0.1.0-preview.5</PackageVersion>
    <Description>Validates and composes Trykatch full-stack modules.</Description>
    <PackageProjectUrl>https://trykatch.net</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TrykatchApp.UnitTests" />
  </ItemGroup>
</Project>
