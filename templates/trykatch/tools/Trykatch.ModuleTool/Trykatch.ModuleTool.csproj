<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>trykatch</ToolCommandName>
    <PackageId>Trykatch.Cli</PackageId>
    <PackageVersion>0.1.0-preview.19</PackageVersion>
    <Version>$(PackageVersion)</Version>
    <Description>Validates and composes Trykatch full-stack modules.</Description>
    <PackageProjectUrl>https://trykatch.net</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="Scaffolding/Templates/*.tpl">
      <LogicalName>Trykatch.ModuleTool.Scaffolding.Templates.%(Filename)%(Extension)</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Trykatch.UnitTests" />
  </ItemGroup>
</Project>
