{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trykatch.net/schemas/module-manifest.v1.json",
  "title": "Trykatch module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "publisher",
    "distribution",
    "compatibility",
    "requires",
    "optionalDependencies",
    "capabilities",
    "dataOwnership",
    "artifacts",
    "entrypoints",
    "contributions"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/moduleId" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "$ref": "#/$defs/version" },
    "description": { "type": "string", "minLength": 1 },
    "publisher": { "$ref": "#/$defs/moduleId" },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "license"],
      "properties": {
        "kind": { "enum": ["workspace", "package"] },
        "license": { "type": "string", "minLength": 1 },
        "dotnet": { "$ref": "#/$defs/packageIdentity" },
        "web": { "$ref": "#/$defs/packageIdentity" },
        "supplyChain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provenanceFile", "provenanceSha256", "provenanceSignatureFile", "sbomFile", "sbomSha256"],
          "properties": {
            "provenanceFile": { "$ref": "#/$defs/relativePath" },
            "provenanceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "provenanceSignatureFile": { "$ref": "#/$defs/relativePath" },
            "sbomFile": { "$ref": "#/$defs/relativePath" },
            "sbomSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "package" } }, "required": ["kind"] },
          "then": { "required": ["dotnet", "supplyChain"] }
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumHostVersion", "maximumHostVersionExclusive"],
      "properties": {
        "minimumHostVersion": { "$ref": "#/$defs/version" },
        "maximumHostVersionExclusive": { "$ref": "#/$defs/version" }
      }
    },
    "requires": { "$ref": "#/$defs/moduleIds" },
    "optionalDependencies": { "$ref": "#/$defs/moduleIds" },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["api", "web", "data", "background-work", "assistant"]
      }
    },
    "features": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/moduleFeature" }
    },
    "quotaResources": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/moduleQuotaResource" }
    },
    "dataOwnership": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "resources"],
          "properties": {
            "default": { "$ref": "#/$defs/ownership" },
            "resources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "schema", "table", "ownership"],
                "properties": {
                  "name": {
                    "anyOf": [
                      { "$ref": "#/$defs/contractId" },
                      { "$ref": "#/$defs/sqlIdentifier" }
                    ]
                  },
                  "schema": { "$ref": "#/$defs/sqlIdentifier" },
                  "table": { "$ref": "#/$defs/sqlIdentifier" },
                  "ownership": { "$ref": "#/$defs/ownership" },
                  "entityType": { "type": "string", "minLength": 1 },
                  "isolationPolicy": { "$ref": "#/$defs/sqlIdentifier" },
                  "accessRule": { "enum": ["platform-only", "identity-only", "global-read-only", "host-only"] }
                },
                "allOf": [
                  {
                    "if": { "properties": { "ownership": { "const": "organization" } } },
                    "then": { "required": ["entityType", "isolationPolicy"] }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "sourceRoot": ["sourceTreeSha256"],
        "sourceTreeSha256": ["sourceRoot"]
      },
      "required": ["dotnetProject"],
      "properties": {
        "dotnetProject": { "type": "string" },
        "webPackage": { "type": "string" },
        "sourceRoot": { "type": "string" },
        "sourceTreeSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dotnet"],
      "properties": {
        "dotnet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
            }
          }
        },
        "web": {
          "type": "object",
          "additionalProperties": false,
          "required": ["specifier", "export"],
          "properties": {
            "specifier": { "type": "string" },
            "export": {
              "type": "string",
              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
            }
          }
        }
      }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permissions", "routes", "extensionPoints", "extensions", "assistantTools"],
      "properties": {
        "permissions": { "$ref": "#/$defs/contracts" },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path"],
            "properties": {
              "id": { "$ref": "#/$defs/contractId" },
              "path": { "type": "string", "pattern": "^/" }
            }
          }
        },
        "extensionPoints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": { "id": { "$ref": "#/$defs/contractId" } }
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "point"],
            "properties": {
              "id": { "$ref": "#/$defs/contractId" },
              "point": { "$ref": "#/$defs/contractId" }
            }
          }
        },
        "assistantTools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "operationId", "risk", "requiresHumanConfirmation"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
              },
              "operationId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "risk": { "enum": ["read-only", "state-changing"] },
              "requiresHumanConfirmation": { "type": "boolean" }
            }
          }
        }
      }
    },
    "execution": { "$ref": "#/$defs/execution" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capabilities": { "contains": { "const": "web" } }
        },
        "required": ["capabilities"]
      },
      "then": {
        "properties": {
          "artifacts": { "required": ["webPackage"] },
          "entrypoints": { "required": ["web"] }
        }
      }
    }
  ],
  "$defs": {
    "moduleQuotaResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "description", "unit"],
      "properties": {
        "key": { "$ref": "#/$defs/quotaStableKey" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
        "unit": { "enum": ["bytes", "count"] },
        "uploadPolicy": { "$ref": "#/$defs/quotaUploadPolicy" },
        "inventorySource": { "$ref": "#/$defs/quotaInventorySource" },
        "removalPolicy": { "$ref": "#/$defs/quotaRemovalPolicy" }
      }
    },
    "quotaUploadPolicy": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["policyKey", "policyVersion", "requiredPermission"],
      "properties": {
        "policyKey": { "$ref": "#/$defs/quotaStableKey" },
        "policyVersion": { "$ref": "#/$defs/positiveVersion" },
        "requiredPermission": { "$ref": "#/$defs/quotaStableKey" }
      }
    },
    "quotaInventorySource": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["sourceKey", "sourceVersion"],
      "properties": {
        "sourceKey": { "$ref": "#/$defs/quotaStableKey" },
        "sourceVersion": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "quotaRemovalPolicy": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["policyKey", "policyVersion"],
      "properties": {
        "policyKey": { "$ref": "#/$defs/quotaStableKey" },
        "policyVersion": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "quotaStableKey": {
      "type": "string", "minLength": 1, "maxLength": 120,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "not": { "pattern": "\\s" }
    },
    "moduleFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "description", "defaultEnabled"],
      "properties": {
        "key": { "$ref": "#/$defs/stableKey" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "defaultEnabled": { "type": "boolean" }
      }
    },
    "stableKey": { "type": "string", "maxLength": 120, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "realtimeStableKey": { "type": "string", "maxLength": 160, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "realtimePolicyKey": { "type": "string", "maxLength": 158, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "positiveVersion": { "type": "integer", "minimum": 1 },
    "payloadBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "execution": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } },
        "systemGrants": { "type": "array", "items": { "$ref": "#/$defs/systemGrant" } },
        "integrationEvents": { "type": "array", "items": { "$ref": "#/$defs/integrationEvent" } },
        "eventConsumers": { "type": "array", "items": { "$ref": "#/$defs/eventConsumer" } },
        "jobs": { "type": "array", "items": { "$ref": "#/$defs/job" } },
        "recurringSchedules": { "type": "array", "items": { "$ref": "#/$defs/recurringSchedule" } },
        "realtimeAudiencePolicies": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/realtimeAudiencePolicy" } }
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["operationKey", "operationVersion", "executionKind", "payloadSchemaKey", "payloadSchemaVersion", "requiredPermissionKeys", "resourcePolicyKey", "maximumPayloadBytes"],
      "properties": {
        "operationKey": { "$ref": "#/$defs/stableKey" }, "operationVersion": { "$ref": "#/$defs/positiveVersion" },
        "executionKind": { "enum": ["user-command", "committed-event", "scheduled-system"] },
        "payloadSchemaKey": { "$ref": "#/$defs/stableKey" }, "payloadSchemaVersion": { "$ref": "#/$defs/positiveVersion" },
        "requiredPermissionKeys": { "$ref": "#/$defs/contracts" }, "resourcePolicyKey": { "$ref": "#/$defs/stableKey" },
        "systemGrantKey": { "anyOf": [{ "$ref": "#/$defs/stableKey" }, { "type": "null" }] }, "maximumPayloadBytes": { "$ref": "#/$defs/payloadBytes" }
      }
    },
    "systemGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["grantKey", "grantVersion", "auditActorId", "allowedOperationKeys", "allowedResourceKeys"],
      "properties": {
        "grantKey": { "$ref": "#/$defs/stableKey" }, "grantVersion": { "$ref": "#/$defs/positiveVersion" },
        "auditActorId": { "type": "string", "format": "uuid" },
        "allowedOperationKeys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stableKey" } },
        "allowedResourceKeys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stableKey" } },
        "allowedRealtimePolicies": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/realtimePolicyRef" } },
        "allowedQuotaResources": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/quotaStableKey" } }
      }
    },
    "realtimeAudiencePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["policyKey", "policyVersion", "allowedAudiences", "allowedResourceKeys", "requiredUserPermissionKeys", "allowedEvents", "allowedSystemProducers"],
      "properties": {
        "policyKey": { "$ref": "#/$defs/realtimePolicyKey" },
        "policyVersion": { "$ref": "#/$defs/positiveVersion" },
        "allowedAudiences": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "enum": ["organization", "user", "resource"] } },
        "allowedResourceKeys": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/realtimeStableKey" } },
        "requiredUserPermissionKeys": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/realtimeStableKey" } },
        "allowedEvents": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/realtimeEventVersion" } },
        "allowedSystemProducers": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/realtimeProducer" } }
      }
    },
    "realtimePolicyRef": {
      "type": "object", "additionalProperties": false,
      "required": ["ownerModuleId", "policyKey", "policyVersion"],
      "properties": {
        "ownerModuleId": { "$ref": "#/$defs/moduleId" },
        "policyKey": { "$ref": "#/$defs/realtimePolicyKey" },
        "policyVersion": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "realtimeEventVersion": {
      "type": "object", "additionalProperties": false,
      "required": ["eventKey", "schemaVersion"],
      "properties": {
        "eventKey": { "$ref": "#/$defs/realtimeStableKey" },
        "schemaVersion": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "realtimeProducer": {
      "type": "object", "additionalProperties": false,
      "required": ["moduleId", "operationKey", "operationVersion"],
      "properties": {
        "moduleId": { "$ref": "#/$defs/moduleId" },
        "operationKey": { "$ref": "#/$defs/realtimeStableKey" },
        "operationVersion": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "integrationEvent": {
      "type": "object", "additionalProperties": false, "required": ["eventKey", "schemaVersion", "maximumPayloadBytes"],
      "properties": { "eventKey": { "$ref": "#/$defs/stableKey" }, "schemaVersion": { "$ref": "#/$defs/positiveVersion" }, "maximumPayloadBytes": { "$ref": "#/$defs/payloadBytes" } }
    },
    "eventVersion": {
      "type": "object", "additionalProperties": false, "required": ["eventKey", "schemaVersion"],
      "properties": { "eventKey": { "$ref": "#/$defs/stableKey" }, "schemaVersion": { "$ref": "#/$defs/positiveVersion" } }
    },
    "eventConsumer": {
      "type": "object", "additionalProperties": false, "required": ["consumerKey", "acceptedEvents", "operationKey", "operationVersion", "systemGrantKey"],
      "properties": {
        "consumerKey": { "$ref": "#/$defs/stableKey" }, "acceptedEvents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/eventVersion" } },
        "operationKey": { "$ref": "#/$defs/stableKey" }, "operationVersion": { "$ref": "#/$defs/positiveVersion" }, "systemGrantKey": { "$ref": "#/$defs/stableKey" }
      }
    },
    "job": {
      "type": "object", "additionalProperties": false,
      "required": ["jobKey", "jobVersion", "operationKey", "operationVersion", "executionKind", "payloadSchemaKey", "payloadSchemaVersion", "maximumPayloadBytes"],
      "properties": {
        "jobKey": { "$ref": "#/$defs/stableKey" }, "jobVersion": { "$ref": "#/$defs/positiveVersion" },
        "operationKey": { "$ref": "#/$defs/stableKey" }, "operationVersion": { "$ref": "#/$defs/positiveVersion" },
        "executionKind": { "enum": ["user-command", "committed-event", "scheduled-system"] },
        "payloadSchemaKey": { "$ref": "#/$defs/stableKey" }, "payloadSchemaVersion": { "$ref": "#/$defs/positiveVersion" }, "maximumPayloadBytes": { "$ref": "#/$defs/payloadBytes" }
      }
    },
    "recurringSchedule": {
      "type": "object", "additionalProperties": false, "required": ["scheduleKey", "jobKey", "jobVersion", "utcSchedule", "misfirePolicy", "systemGrantKey"],
      "properties": {
        "scheduleKey": { "$ref": "#/$defs/stableKey" }, "jobKey": { "$ref": "#/$defs/stableKey" }, "jobVersion": { "$ref": "#/$defs/positiveVersion" },
        "utcSchedule": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\r\\n]+$" },
        "misfirePolicy": { "enum": ["coalesce", "catch-up"] }, "systemGrantKey": { "$ref": "#/$defs/stableKey" }
      }
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "moduleIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/moduleId" }
    },
    "contractId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*([.-][a-z0-9]+)*$"
    },
    "ownership": {
      "enum": ["organization", "platform", "global", "infrastructure"]
    },
    "sqlIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "contracts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contractId" }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:/|[A-Za-z]:[\\\\/])" }
    },
    "packageIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "packageFile", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" },
        "packageFile": { "$ref": "#/$defs/relativePath" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
