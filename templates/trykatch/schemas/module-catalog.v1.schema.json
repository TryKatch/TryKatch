{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trykatch.net/schemas/module-catalog.v1.json",
  "title": "Trykatch module catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hostVersion", "lockFile", "trustedPublishers", "outputs", "modules"],
  "properties": {
    "publisherTrust": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nugetSignerSha256", "attestationPublicKey", "builderId"],
        "properties": {
          "nugetSignerSha256": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" } },
          "attestationPublicKey": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----" },
          "builderId": { "type": "string", "format": "uri" },
          "maximumAttestationAgeDays": { "type": "integer", "minimum": 1, "maximum": 30 }
        }
      }
    },
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "hostVersion": { "$ref": "#/$defs/version" },
    "lockFile": { "$ref": "#/$defs/relativePath" },
    "trustedPublishers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/moduleId" }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "backendNamespace",
        "migrator",
        "migratorNamespace",
        "web"
      ],
      "properties": {
        "backend": { "$ref": "#/$defs/relativePath" },
        "backendNamespace": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "dotnetModuleContractNamespace": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "migrator": { "$ref": "#/$defs/relativePath" },
        "migratorNamespace": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "web": { "$ref": "#/$defs/relativePath" },
        "webModuleSdkSpecifier": { "type": "string", "minLength": 1 }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "manifest", "enabled"],
        "properties": {
          "id": { "$ref": "#/$defs/moduleId" },
          "manifest": { "$ref": "#/$defs/relativePath" },
          "enabled": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:/|[A-Za-z]:[\\\\/])" }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
