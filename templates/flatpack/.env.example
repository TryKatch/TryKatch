FLATPACK_MIGRATOR_PASSWORD=<set-in-secret-store>
FLATPACK_RUNTIME_CONNECTION=<set-in-secret-store>
GRAFANA_ADMIN_PASSWORD=<set-in-secret-store>
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OpenIddict__SigningCertificate__Path=/run/secrets/signing.pfx
OpenIddict__SigningCertificate__Password=<set-in-secret-store>
OpenIddict__EncryptionCertificate__Path=/run/secrets/encryption.pfx
OpenIddict__EncryptionCertificate__Password=<set-in-secret-store>
# Optional client bootstrap: OpenIddict__Clients__0__ClientId, __GrantType,
# __ClientSecret, and __RedirectUris__0. Remove secrets after provisioning.
