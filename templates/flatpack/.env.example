FLATPACK_POSTGRES_ADMIN_PASSWORD=replace-with-a-bootstrap-only-random-secret
FLATPACK_MIGRATOR_PASSWORD=replace-with-migrator-random-secret
FLATPACK_RUNTIME_PASSWORD=replace-with-runtime-random-secret
FLATPACK_MIGRATOR_CONNECTION=Host=postgres;Port=5432;Database=flatpack;Username=flatpack_migrator;Password=replace-with-migrator-random-secret
FLATPACK_RUNTIME_CONNECTION=Host=postgres;Port=5432;Database=flatpack;Username=flatpack_runtime;Password=replace-with-runtime-random-secret
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-secret
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OpenIddict__SigningCertificate__Path=/run/secrets/signing.pfx
OpenIddict__SigningCertificate__Password=replace-with-the-signing-certificate-secret
OpenIddict__EncryptionCertificate__Path=/run/secrets/encryption.pfx
OpenIddict__EncryptionCertificate__Password=replace-with-the-encryption-certificate-secret
# Optional client bootstrap: OpenIddict__Clients__0__ClientId, __GrantType,
# __ClientSecret, and __RedirectUris__0. Remove secrets after provisioning.
