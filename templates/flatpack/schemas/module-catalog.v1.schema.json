{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flatpack.dev/schemas/module-catalog.v1.json",
  "title": "Flatpack module catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hostVersion", "lockFile", "outputs", "modules"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "hostVersion": { "$ref": "#/$defs/version" },
    "lockFile": { "$ref": "#/$defs/relativePath" },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "backendNamespace", "migrator", "migratorNamespace", "web"],
      "properties": {
        "backend": { "$ref": "#/$defs/relativePath" },
        "backendNamespace": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "migrator": { "$ref": "#/$defs/relativePath" },
        "migratorNamespace": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "web": { "$ref": "#/$defs/relativePath" }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "manifest", "enabled"],
        "properties": {
          "id": { "$ref": "#/$defs/moduleId" },
          "manifest": { "$ref": "#/$defs/relativePath" },
          "enabled": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:/|[A-Za-z]:[\\\\/])" }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
