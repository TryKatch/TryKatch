{
  "schemaVersion": 1,
  "source": {
    "openapi": "3.1.1",
    "title": "Flatpack API",
    "version": "v1"
  },
  "modules": [
    {
      "id": "projects",
      "name": "Projects",
      "version": "1.0.0",
      "capabilities": [
        "Api",
        "Web",
        "Data",
        "BackgroundWork",
        "Assistant"
      ]
    },
    {
      "id": "getting-started",
      "name": "Getting Started",
      "version": "1.0.0",
      "capabilities": [
        "Api",
        "Web",
        "Assistant"
      ]
    }
  ],
  "policy": {
    "default": "deny",
    "authorization": "The API re-authorizes every tool call; the model never grants access.",
    "writes": "Mutating and destructive tools require an explicit allowlist entry and human confirmation."
  },
  "tools": [
    {
      "type": "function",
      "name": "flatpack_get_module_readiness",
      "description": "Check whether the current organization request crossed the identity, organization, permission, and frontend module seams.",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "flatpack_get_project",
      "description": "Get one project by its identifier in the current organization workspace.",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "flatpack_list_projects",
      "description": "List the projects visible in the current organization workspace.",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "pageSize": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "search": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "lifecycle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "page",
          "pageSize",
          "search",
          "lifecycle"
        ],
        "additionalProperties": false
      }
    }
  ],
  "bindings": {
    "flatpack_get_module_readiness": {
      "operationId": "GettingStarted_Get",
      "method": "GET",
      "path": "/api/v1/getting-started",
      "moduleId": "getting-started",
      "risk": "read-only",
      "requiresHumanConfirmation": false,
      "authorization": "api-enforced",
      "organizationContext": "request-derived"
    },
    "flatpack_get_project": {
      "operationId": "Projects_Get",
      "method": "GET",
      "path": "/api/v1/projects/{id}",
      "moduleId": "projects",
      "risk": "read-only",
      "requiresHumanConfirmation": false,
      "authorization": "api-enforced",
      "organizationContext": "request-derived"
    },
    "flatpack_list_projects": {
      "operationId": "Projects_List",
      "method": "GET",
      "path": "/api/v1/projects",
      "moduleId": "projects",
      "risk": "read-only",
      "requiresHumanConfirmation": false,
      "authorization": "api-enforced",
      "organizationContext": "request-derived"
    }
  }
}
