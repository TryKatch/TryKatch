{
  "$schema": "https://flatpack.dev/schemas/module-manifest.v1.json",
  "schemaVersion": 1,
  "id": "getting-started",
  "name": "Getting Started",
  "version": "1.0.0",
  "description": "A reference module that proves Flatpack's backend and frontend composition seams.",
  "compatibility": {
    "minimumHostVersion": "0.1.0",
    "maximumHostVersionExclusive": "1.0.0"
  },
  "requires": ["projects"],
  "optionalDependencies": [],
  "capabilities": ["api", "web", "assistant"],
  "artifacts": {
    "dotnetProject": "src/FlatpackApp.Modules.GettingStarted/FlatpackApp.Modules.GettingStarted.csproj",
    "webPackage": "web/packages/module-getting-started/package.json"
  },
  "entrypoints": {
    "dotnet": {
      "type": "FlatpackApp.Modules.GettingStarted.GettingStartedModule"
    },
    "web": {
      "specifier": "@flatpackapp/module-getting-started",
      "export": "gettingStartedModule"
    }
  },
  "contributions": {
    "permissions": ["getting-started.read"],
    "routes": [
      { "id": "getting-started.overview", "path": "/getting-started" }
    ],
    "extensionPoints": [],
    "extensions": [
      { "id": "getting-started.projects-status", "point": "projects.list.after-table" }
    ],
    "assistantTools": [
      {
        "name": "flatpack_get_module_readiness",
        "operationId": "GettingStarted_Get",
        "risk": "read-only",
        "requiresHumanConfirmation": false
      }
    ]
  }
}
