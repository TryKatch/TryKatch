{
  "$schema": "https://flatpack.dev/schemas/module-manifest.v1.json",
  "schemaVersion": 1,
  "id": "getting-started",
  "name": "Getting Started",
  "version": "1.0.0",
  "description": "A small reference module that proves Flatpack's backend and frontend composition seams.",
  "requires": ["projects"],
  "capabilities": ["api", "web"],
  "packages": {
    "dotnet": "Flatpack.Modules.GettingStarted",
    "web": "@flatpackapp/module-getting-started"
  },
  "entrypoints": {
    "dotnet": "FlatpackApp.Modules.GettingStarted.GettingStartedModule",
    "web": "gettingStartedModule"
  }
}
