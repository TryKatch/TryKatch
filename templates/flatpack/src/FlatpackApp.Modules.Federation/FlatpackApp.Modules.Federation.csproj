<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Flatpack.Modules.Federation</PackageId>
    <Description>OIDC federation module for Flatpack applications.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FlatpackApp.Modules.Abstractions/FlatpackApp.Modules.Abstractions.csproj" />
    <ProjectReference Include="../FlatpackApp.Modules.AspNetCore/FlatpackApp.Modules.AspNetCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="flatpack.module.json" Pack="true" PackagePath="content/flatpack.module.json" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
