{
  "$schema": "https://flatpack.dev/schemas/module-manifest.v1.json",
  "schemaVersion": 1,
  "id": "federation",
  "name": "Single sign-on",
  "version": "1.0.0",
  "description": "Generic OpenID Connect connection management and federation security policy.",
  "distribution": {
    "kind": "workspace",
    "license": "Apache-2.0"
  },
  "compatibility": {
    "minimumHostVersion": "0.1.0",
    "maximumHostVersionExclusive": "1.0.0"
  },
  "requires": [],
  "optionalDependencies": [],
  "capabilities": ["api", "web", "data"],
  "artifacts": {
    "dotnetProject": "src/FlatpackApp.Modules.Federation/FlatpackApp.Modules.Federation.csproj",
    "webPackage": "web/packages/module-federation/package.json"
  },
  "entrypoints": {
    "dotnet": {
      "type": "FlatpackApp.Modules.Federation.FederationModule"
    },
    "web": {
      "specifier": "@flatpackapp/module-federation",
      "export": "federationModule"
    }
  },
  "contributions": {
    "permissions": [],
    "routes": [
      { "id": "federation.connections", "path": "/authentication/sso" }
    ],
    "extensionPoints": [],
    "extensions": [],
    "assistantTools": []
  }
}
