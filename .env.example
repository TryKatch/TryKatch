# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TryKatch

# Contact Form (if using email service)
# SMTP_HOST=your-smtp-host
# SMTP_PORT=587
# SMTP_USER=your-email@domain.com
# SMTP_PASS=your-email-password
# CONTACT_EMAIL=contact@trykatch.com

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Database (if needed in future)
# DATABASE_URL=your-database-connection-string

# API Keys (add as needed)
# NEXT_PUBLIC_API_KEY=your-public-api-key
# API_SECRET_KEY=your-secret-api-key

# Social Media Links
# NEXT_PUBLIC_TWITTER_URL=https://twitter.com/trykatch
# NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/trykatch
# NEXT_PUBLIC_GITHUB_URL=https://github.com/trykatch
