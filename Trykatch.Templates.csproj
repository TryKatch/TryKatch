<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Trykatch.Templates</PackageId>
    <PackageVersion>0.1.0-preview.12</PackageVersion>
    <Title>Trykatch enterprise application templates</Title>
    <Authors>Trykatch contributors</Authors>
    <Description>Enterprise multi-tenant .NET 10, PostgreSQL, React, TanStack, and OpenTelemetry application template.</Description>
    <PackageProjectUrl>https://trykatch.net</PackageProjectUrl>
    <PackageTags>dotnet-new;template;postgresql;react;multitenancy;aspire</PackageTags>
    <PackageType>Template</PackageType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates/**/*" Exclude="templates/**/bin/**;templates/**/obj/**;templates/**/node_modules/**;templates/**/dist/**;templates/**/.git/**;templates/**/.idea/**;templates/**/.vscode/**;templates/**/.vercel/**;templates/**/.playwright-cli/**;templates/**/artifacts/**;templates/**/output/**;templates/**/coverage/**;templates/**/playwright-report/**;templates/**/test-results/**;templates/**/*.tsbuildinfo;templates/**/*.user;templates/**/*.trx;templates/**/*.log;templates/**/*.nupkg;templates/**/*.snupkg;templates/**/.DS_Store;templates/**/.env;templates/**/.env.*;templates/**/secrets/**;templates/**/*.pfx;templates/**/*.p12;templates/**/*.pem;templates/**/*.key" />
    <Content Include="templates/trykatch/.env.example" />
    <Content Include="README.md" Pack="true" PackagePath="/" />
    <Compile Remove="**/*" />
  </ItemGroup>
</Project>
